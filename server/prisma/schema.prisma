generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uuid                 String        @id @default(uuid())
  email                String        @unique
  first_name           String
  last_name            String
  password             String
  blockchainPublicKey  String        @unique
  properties           Property[]    @relation("UserProperties")
  transactionsAsBuyer  Transaction[] @relation("BuyerTransactions")
  transactionsAsSeller Transaction[] @relation("SellerTransactions")
}

model Property {
  id           String       @id @default(cuid())
  name         String
  location     String
  features     String[]
  description  String
  price        String
  type         PropertyType
  image        String
  contractText String
  tokenID      String
  ipfsHash     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String
  user         User         @relation("UserProperties", fields: [userId], references: [uuid])
  listed       Boolean      @default(false)

  Transaction Transaction[]
}

enum PropertyType {
  apartment
  house
}

model Transaction {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        User     @relation("BuyerTransactions", fields: [buyerId], references: [uuid])
  sellerId     String
  seller       User     @relation("SellerTransactions", fields: [sellerId], references: [uuid])
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  amount       String
  buyerAccept  Boolean  @default(true)
  sellerAccept Boolean  @default(false)
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
